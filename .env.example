# Copy to backend/.env for local development. Never commit real values.
# Variable names are case-insensitive; list values use JSON syntax. Full reference: backend/app/core/config.py

# --- Runtime ---
ENVIRONMENT=development            # development | test | production
LOG_LEVEL=INFO
LOG_JSON=true
DEMO_MODE=false                    # allow mock providers when ENVIRONMENT=production (labelled "demo / mock" in the UI)

# --- Database (must use the psycopg 3 driver; on Neon use the *direct* endpoint, not -pooler) ---
DATABASE_URL=postgresql+psycopg://atlas:atlas@localhost:5432/atlas
CORS_ORIGINS=["http://localhost:5173"]

# --- Auth ---
JWT_SECRET=                        # required in production, >= 32 chars (dev generates one per process)
ALLOW_REGISTRATION=true

# --- Providers (verified available 2026-10-24; see docs/architecture.md §7) ---
LLM_PROVIDER=groq                  # groq | nvidia | gemini | openrouter | mock
LLM_MODEL=openai/gpt-oss-120b
# Ordered fallbacks ("provider:model"), one account per provider, used only on rate limits, outages,
# timeouts, unavailable models or empty answers. OpenRouter entries must end in ":free".
LLM_FALLBACK_CHAIN=["groq:openai/gpt-oss-20b","gemini:gemini-3.6-flash","openrouter:nvidia/nemotron-3-ultra-550b-a55b:free","openrouter:poolside/laguna-s-2.1:free","nvidia:nvidia/nemotron-3-ultra-550b-a55b"]
EMBEDDING_PROVIDER=nvidia          # nvidia | mock
EMBEDDING_MODEL=nvidia/nemotron-3.5-embed-1b
EMBEDDING_DIMENSION=1024           # <= 2000 so pgvector HNSW can index it
RERANKER_PROVIDER=none             # none | local (uv sync --extra rerank-local) | nvidia | mock
RERANKER_MODEL=                    # e.g. Xenova/ms-marco-MiniLM-L-6-v2 for local

# --- Secrets (server-side only) ---
GROQ_API_KEY=
NVIDIA_API_KEY=
GEMINI_API_KEY=                    # Google AI Studio key (GOOGLE_API_KEY also accepted)
OPENROUTER_API_KEY=

# --- Retrieval and agent ---
RETRIEVAL_MODE=hybrid              # dense | lexical | hybrid | hybrid_rerank
RETRIEVAL_TOP_K=6
MIN_DENSE_SIMILARITY=0.25          # calibrated for nemotron-3.5-embed-1b@1024; recalibrate per model
AGENT_MAX_RETRIEVAL_ATTEMPTS=2
AGENT_MAX_LLM_CALLS=4

# --- Ingestion ---
MAX_UPLOAD_BYTES=20971520
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
URL_ALLOWED_HOSTS=[]               # empty = any public host

# --- Abuse controls (per user / per IP) ---
RATE_LIMIT_CHAT_PER_MINUTE=20
RATE_LIMIT_INGEST_PER_MINUTE=30
RATE_LIMIT_AUTH_PER_MINUTE=10

# --- Optional observability (off by default; LangSmith receives prompt text) ---
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
OTEL_ENABLED=false                 # needs: uv sync --extra observability, plus OTEL_EXPORTER_OTLP_ENDPOINT
